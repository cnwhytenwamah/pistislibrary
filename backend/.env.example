NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pistis_library
REDIS_URL=redis://localhost:6379

# Public URL of the Next.js frontend (CORS + the foundation check)
CLIENT_URL=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-a-random-string-of-32+-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated Google OAuth client IDs (web now; add Android/iOS IDs for Expo later)
GOOGLE_CLIENT_IDS=xxxxxxxx.apps.googleusercontent.com

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO)
# Local MinIO (docker compose up -d): endpoint http://localhost:9000, path style true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pistis-library
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Optional: if the bucket (or a CDN in front of it) is public for covers, set its base URL.
# When empty, cover URLs are short-lived signed URLs.
S3_PUBLIC_URL=

MAX_BOOK_FILE_MB=100
MAX_COVER_MB=5
SIGNED_URL_TTL_SECONDS=900
